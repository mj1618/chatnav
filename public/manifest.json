{
  "manifest_version": 3,
  "name": "React Chrome Extension",
  "version": "1.0.1",
  "description": "A simple React app as a Chrome extension",
  "action": {
    "default_popup": "index.html"
  },
  "permissions": [
    "tabs",
    "windows",
    "activeTab",
    "offscreen",
    "background"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "*://*/*"
  ]
}